SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=dailyops-uploads
KIOSK_TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-characters
APP_PUBLIC_URL=https://dqops.net

# Average Guys platform administration. Use lowercase email addresses separated by commas.
PLATFORM_ADMIN_EMAILS=owner@avgguysbs.com
PLATFORM_FEEDBACK_EMAIL=feedback@avgguysbs.com

# Email notifications. Mailgun is preferred when these values are present.
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-mailgun-domain
MAILGUN_FROM_EMAIL="HIS OPS <notifications@your-domain.com>"
MAILGUN_BASE_URL=https://api.mailgun.net

# Signed Mailgun inbound routes. Sender lists use commas, not semicolons.
MAILGUN_WEBHOOK_SIGNING_KEY=your-mailgun-webhook-signing-key
FINANCIAL_REPORT_INBOUND_ADDRESS=reports@your-domain.com
FINANCIAL_REPORT_ALLOWED_SENDERS=reports@example.com,owner@example.com
STORE_DOCUMENT_INBOUND_ADDRESS=inspections@your-domain.com
STORE_DOCUMENT_ALLOWED_SENDERS=inspector@example.com,owner@example.com
FPC_INBOUND_ADDRESS=fpc@your-domain.com
FPC_ALLOWED_SENDERS=inspector@example.com,owner@example.com

# Optional fallback if using Resend instead of Mailgun.
RESEND_API_KEY=your-resend-api-key
ALERT_EMAIL_FROM="HIS OPS <notifications@your-domain.com>"

# Text notifications.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567
ALERT_CRON_SECRET=make-a-long-random-secret
